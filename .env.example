# Copy to .env and adjust. Without a .env the app uses a local SQLite file (newsportal.db).

# PostgreSQL (recommended for deployment):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/newsportal
DATABASE_URL=sqlite:///./newsportal.db

# Used to sign JWT access tokens. Use a long random value in production.
SECRET_KEY=change-this-secret-in-production
TOKEN_EXPIRE_MINUTES=1440
